APP_NAME="Lost & Found Campus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lostfound
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Driver autentikasi portal: "fake" (dev/testing) atau "bridge" (production).
# Untuk pengujian lokal gunakan: fake
# Untuk server kampus sesungguhnya ubah ke: PORTAL_DRIVER=bridge
PORTAL_DRIVER=fake
PORTAL_BRIDGE_URL=https://portal.uinssc.ac.id/api/v1/auth/verify
PORTAL_BRIDGE_SECRET=your-bridge-api-secret-key
PORTAL_TIMEOUT=10

PORTAL_DRIVER=bridge
PORTAL_BASE_URL=https://bridge.uinssc.ac.id/api
PORTAL_BRIDGE_TOKEN=informatika-bridge-token
PORTAL_TIMEOUT=15
